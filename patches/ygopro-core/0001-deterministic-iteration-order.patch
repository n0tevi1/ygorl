+namespace {
+// ygorl: stable, address-independent order for effects and cards.
+bool effect_order(const effect* a, const effect* b) {
+	if(a->id != b->id)
+		return a->id < b->id;
+	if(a->initial_id != b->initial_id)
+		return a->initial_id < b->initial_id;
+	if(a->code != b->code)
+		return a->code < b->code;
+	if(a->type != b->type)
+		return a->type < b->type;
+	return a->description < b->description;
+}
+std::vector<effect*> sorted_effects(std::vector<effect*> ordered) {
+	std::sort(ordered.begin(), ordered.end(), effect_order);
+	return ordered;
+}
+}
+std::vector<effect*> field_effect::deterministic_order(const effect_collection& coll) {
+	return sorted_effects(std::vector<effect*>(coll.begin(), coll.end()));
+}
+std::vector<effect*> field_effect::deterministic_order(const effect_indexer& indexer) {
+	std::vector<effect*> ordered;
+	ordered.reserve(indexer.size());
+	for(const auto& entry : indexer)
+		ordered.push_back(entry.first);
+	return sorted_effects(std::move(ordered));
+}
+std::vector<effect*> field_effect::deterministic_order(const oath_effects& oath) {
+	std::vector<effect*> ordered;
+	ordered.reserve(oath.size());
+	for(const auto& entry : oath)
+		ordered.push_back(entry.first);
+	return sorted_effects(std::move(ordered));
+}
+std::vector<card*> field_effect::deterministic_order(const std::unordered_set<card*>& cards) {
+	std::vector<card*> ordered(cards.begin(), cards.end());
+	std::sort(ordered.begin(), ordered.end(), [](const card* a, const card* b) { return a->cardid < b->cardid; });
+	return ordered;
+}
