+	case MSG_ANNOUNCE_CARD: {
+		// Recognize the WHOLE finite whitelist: code ISCODE, then zero or
+		// more (code ISCODE OR) terms. Other RPN filters remain unsupported.
+		r.Get<uint8_t>();
+		const uint8_t count = r.Get<uint8_t>();
+		if(count < 2 || (count - 2) % 3 || len != 2u + 8u * count || !opt.db)
+			return;
+		std::vector<uint32_t> declared;
+		for(uint32_t i = 0; i < count;) {
+			const uint64_t code = r.Get<uint64_t>();
+			const uint64_t opcode = r.Get<uint64_t>();
+			if(!r.Ok() || code == 0 || code > UINT32_MAX || opcode != OPCODE_ISCODE)
+				return;
+			i += 2;
+			if(i > 2) {
+				if(r.Get<uint64_t>() != OPCODE_OR || !r.Ok())
+					return;
+				++i;
+			}
+			declared.push_back(static_cast<uint32_t>(code));
+		}
+		std::sort(declared.begin(), declared.end());
+		declared.erase(std::unique(declared.begin(), declared.end()), declared.end());
+		for(uint32_t code : declared) {
+			const CardRow* row = opt.db->Find(code);
+			if(!row)
+				continue;
+			// Match playerop.cpp's default alias/token exclusion and exceptions.
+			if(code != 78734254 && code != 13857930 &&
+			   (row->alias || (row->type & (TYPE_MONSTER | TYPE_TOKEN)) ==
+			                  (TYPE_MONSTER | TYPE_TOKEN)))
+				continue;
+			Choice& c = out.Emit();
+			PutInt32(c.response, static_cast<int32_t>(code));
+			c.card = code;
+			c.edge = EdgeOf(message, {code});
+			SetLabel(c, opt, "declare", code);
+		}
+		return;
+	}
+
